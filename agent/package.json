{
  "name": "bear-conversation-relay-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "livekit:dev": "LIVEKIT_BEAR_ID=smokey LIVEKIT_AGENT_NAME=smokey-agent tsx src/livekit-agent.ts dev",
    "livekit:maple": "LIVEKIT_BEAR_ID=maple LIVEKIT_AGENT_NAME=maple-agent tsx src/livekit-agent.ts dev",
    "livekit:coordinator": "tsx src/livekit-coordinator.ts dev",
    "livekit:start": "LIVEKIT_BEAR_ID=smokey LIVEKIT_AGENT_NAME=smokey-agent tsx src/livekit-agent.ts start",
    "build": "tsc",
    "heroku-postbuild": "npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-elevenlabs": "^1.9.1",
    "@livekit/agents-plugin-openai": "^1.9.1",
    "@livekit/rtc-node": "^1.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "livekit-server-sdk": "^2.19.1",
    "openai": "^4.85.4",
    "twilio": "^5.4.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
