# Shared by the Next.js app (nextjs/) and the bear agent (agent/), which loads
# this same file via dotenv. Copy to nextjs/.env and fill in.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# DEV or PROD. Selects the *_DEV / *_PROD Twilio keys and agent base URL.
APP_ENV=DEV
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
# Public site URL used to validate Twilio webhook signatures on /call and /sms.
PRODUCTION_BASE_URL=https://mitchellkimbell.com

# ---------------------------------------------------------------------------
# Frontend (browser-visible)
# ---------------------------------------------------------------------------
# Twilio number shown on the Call card (Voice -> /call, Messaging -> /sms).
NEXT_PUBLIC_BEAR_PHONE_NUMBER=
NEXT_PUBLIC_BEAR_AGENT_TO=portfolio-bears
# Used by production browser SSE subscriptions. Development uses https://mkimbell.ngrok.dev.
NEXT_PUBLIC_BEAR_AGENT_BASE_URL=https://your-bear-agent.example.com
# Temporary browser-visible SSE token. It must match BEAR_EVENT_TOKEN below.
# Replace this shared secret with a short-lived signed capability before broad launch.
NEXT_PUBLIC_BEAR_EVENT_TOKEN=replace-with-a-long-random-secret

# Toucan voice agent (optional; defaults are built in).
NEXT_PUBLIC_TOUCAN_AGENT_NGROK_URL=
NEXT_PUBLIC_TOUCAN_AGENT_BACKEND_URL=
NEXT_PUBLIC_TOUCAN_AGENT_TO=
NEXT_PUBLIC_TOUCAN_AGENT_INITIAL_PROMPT=
NEXT_PUBLIC_TOUCAN_AGENT_LANGUAGE=en-US

# ---------------------------------------------------------------------------
# Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Browser Voice SDK keys. `APP_ENV=DEV pnpm twilio:setup` creates the DEV set
# (and APP_ENV=PROD the PROD set) and writes them back into this file.
TWILIO_API_KEY_DEV=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET_DEV=your_dev_api_key_secret
TWILIO_TWIML_APP_SID_DEV=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_PROD=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET_PROD=your_prod_api_key_secret
TWILIO_TWIML_APP_SID_PROD=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCESS_TOKEN_TTL=900
# Twilio Sync token route (/api/twilio/sync-token), used by the toucan agent.
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Bear agent server (agent/src/index.ts)
# ---------------------------------------------------------------------------
# Must be https:// so ConversationRelay can connect over wss://.
DEV_AGENT_BASE_URL=https://mkimbell.ngrok.dev
PROD_AGENT_BASE_URL=https://your-bear-agent.example.com
PORT=3001
PORTFOLIO_ORIGIN=http://localhost:3000
SESSION_IDLE_TTL_MS=900000
# Required by the temporary production agent SSE endpoint. Keep it server-only
# except for the matching temporary NEXT_PUBLIC_BEAR_EVENT_TOKEN above.
BEAR_EVENT_TOKEN=replace-with-a-long-random-secret
# In DEV, Twilio signatures are skipped unless this is true.
TWILIO_VALIDATE_SIGNATURES=false
# Optional Media Streams observer alongside ConversationRelay. It records
# Twilio's telephone tracks at the agent; it does not create browser tracks.
TWILIO_MEDIA_STREAMS_MIRROR=false

# Bear speech uses Twilio ConversationRelay's native ElevenLabs provider.
# It does not require an ELEVENLABS_API_KEY.
SMOKEY_ELEVENLABS_VOICE_ID=oubi7HGxNVjXMnWLgwBT
MAPLE_ELEVENLABS_VOICE_ID=u0REnIJvUgcGQYW2Ux8K
SMOKEY_TTS_LANGUAGE=en-US
MAPLE_TTS_LANGUAGE=en-GB

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
# Optional override for the LiveKit bear dialogue coordinator (falls back to OPENAI_MODEL).
OPENAI_BEAR_DIALOGUE_MODEL=

# ---------------------------------------------------------------------------
# LiveKit browser rooms. Keep the API secret server-only.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret
# Which bear a worker process plays: smokey or maple.
LIVEKIT_BEAR_ID=smokey
# Defaults to "<bear>-agent".
LIVEKIT_AGENT_NAME=
LIVEKIT_SMOKEY_ELEVENLABS_VOICE_ID=oubi7HGxNVjXMnWLgwBT
LIVEKIT_MAPLE_ELEVENLABS_VOICE_ID=oubi7HGxNVjXMnWLgwBT
# ElevenLabs key for LiveKit workers (ELEVENLABS_API_KEY is also accepted).
ELEVEN_API_KEY=your_elevenlabs_api_key
# Start Maple this many milliseconds before Smokey's estimated prefix ending (clamped 250-500).
LIVEKIT_MAPLE_OVERLAP_MS=350

# ---------------------------------------------------------------------------
# Cabin computer "Email" app (POST /api/contact). Set ONE provider; with none
# set, the app opens the visitor's own mail client pre-filled instead.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
RESEND_API_KEY=
# Sender address, verified with whichever provider is used.
CONTACT_FROM_EMAIL=
# Where messages land (defaults to mfkimbell@gmail.com).
CONTACT_TO_EMAIL=
