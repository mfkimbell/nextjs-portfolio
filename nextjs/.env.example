# Frontend
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BEAR_AGENT_TO=portfolio-bears
# Used by production browser SSE subscriptions. Development uses https://mkimbell.ngrok.dev.
NEXT_PUBLIC_BEAR_AGENT_BASE_URL=https://your-bear-agent.example.com
# Temporary browser-visible SSE token. It must match BEAR_EVENT_TOKEN below.
# Replace this shared secret with a short-lived signed capability before broad launch.
NEXT_PUBLIC_BEAR_EVENT_TOKEN=replace-with-a-long-random-secret

# Twilio browser Voice SDK
APP_ENV=DEV
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_DEV=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET_DEV=your_dev_api_key_secret
TWILIO_TWIML_APP_SID_DEV=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_PROD=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET_PROD=your_prod_api_key_secret
TWILIO_TWIML_APP_SID_PROD=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCESS_TOKEN_TTL=900

# LiveKit browser rooms. Keep the API secret server-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=bear-agent
# OpenAI GPT-Live voice presets. Current worker publishes Smokey's track;
# Maple is reserved for the upcoming second LiveKit participant.
# Scripted gpt-4o-mini-tts presets: alloy, ash, ballad, coral, echo,
# fable, nova, onyx, sage, shimmer.
LIVEKIT_SMOKEY_VOICE=ash
LIVEKIT_MAPLE_VOICE=coral
LIVEKIT_SMOKEY_ELEVENLABS_VOICE_ID=oubi7HGxNVjXMnWLgwBT
LIVEKIT_MAPLE_ELEVENLABS_VOICE_ID=oubi7HGxNVjXMnWLgwBT
ELEVEN_API_KEY=your_elevenlabs_api_key
# Start Maple this many milliseconds before Smokey's estimated prefix ending.
LIVEKIT_MAPLE_OVERLAP_MS=850

# OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Bear speech uses Twilio ConversationRelay's native ElevenLabs provider.
# It does not require an ELEVENLABS_API_KEY.
SMOKEY_ELEVENLABS_VOICE_ID=oubi7HGxNVjXMnWLgwBT
MAPLE_ELEVENLABS_VOICE_ID=u0REnIJvUgcGQYW2Ux8K
SMOKEY_TTS_LANGUAGE=en-US
MAPLE_TTS_LANGUAGE=en-GB
# Optional Media Streams observer alongside ConversationRelay. It records
# Twilio's telephone tracks at the agent; it does not create browser tracks.
TWILIO_MEDIA_STREAMS_MIRROR=false
# Required by the temporary production agent SSE endpoint. Keep it server-only
# except for the matching temporary NEXT_PUBLIC_BEAR_EVENT_TOKEN above.
BEAR_EVENT_TOKEN=replace-with-a-long-random-secret

# Cabin computer "Email" app (POST /api/contact). Set ONE provider; with none
# set, the app opens the visitor's own mail client pre-filled instead.
#   SENDGRID_API_KEY=SG.xxxxx
#   RESEND_API_KEY=re_xxxxx
# Sender address, verified with whichever provider is used:
#   CONTACT_FROM_EMAIL=portfolio@yourdomain.com
# Where messages land (defaults to mfkimbell@gmail.com):
#   CONTACT_TO_EMAIL=mfkimbell@gmail.com
